# Required: an absolute path to your installed SuperCoop folder (the one
# install.cmd built - copy it from Windows; every client must have the same
# data). It must be writable by F2_UID:F2_GID: saves live beneath data/.
F2_GAME_PATH=/absolute/path/to/Fallout 2 SuperCoop

# Only needed when compose.yaml lives outside this source checkout.
# F2_SOURCE_PATH=/absolute/path/to/fallout2-ce

# Use `id -u` and `id -g` on Linux. These defaults suit most desktop installs.
F2_UID=1000
F2_GID=1000

# newest = continue the most recently written save, or start a new game on
# F2_SERVER_MAP (default artemple.map) when there is none. Safe across
# restarts. Use a number (1-16) to load that slot instead.
F2_SERVER_LOAD=newest
# F2_SERVER_MAP=artemple.map

F2_SERVER_NAME=Fallout 2 SuperCoop
F2_SERVER_PACE_MS=100
F2_AUTOSAVE_SECS=300

# Server-authoritative difficulty. Values: 0=Easy/Wimpy, 1=Normal,
# 2=Hard/Rough (the hardest in-game settings). Compose defaults both to 2.
F2_GAME_DIFFICULTY=2
F2_COMBAT_DIFFICULTY=2

# Published host ports. The admin channel binds to loopback for safety.
F2_SERVER_NET_PORT=9300
F2_SERVER_CMD_PORT=9301
# F2_SERVER_NET_BIND=0.0.0.0
# F2_SERVER_CMD_BIND=127.0.0.1

# Optional server settings and feature kill switches can be added here; every
# entry in this file is passed through to the container.
# F2_SERVER_HOST=PlayerName
# F2_REQUIRE_TOKEN=1
# F2_MOVIES=0
